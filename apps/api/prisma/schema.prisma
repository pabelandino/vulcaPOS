generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
}

enum SaleKind {
  SALE
  RETURN
}

enum DocStatus {
  PAID
  VOID
}

enum OrderStatus {
  OPEN
  PAID
  VOID
}

enum BroughtItem {
  NONE
  TIRE
  OTHER
}

enum LineKind {
  PRODUCT
  SERVICE
}

enum CashStatus {
  OPEN
  CLOSED
}

enum PayKind {
  SALARY
  ADVANCE
  COMMISSION
  BONUS
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  name         String
  role         Role           @default(CASHIER)
  access       String[]       @default([])
  active       Boolean        @default(true)
  branchId     Int?
  createdAt    DateTime       @default(now())
  branch       Branch?        @relation(fields: [branchId], references: [id])
  sales        Sale[]
  orders       ServiceOrder[]
  sessions     CashSession[]
  receipts     GoodsReceipt[]
  payroll      PayrollPayment[] @relation("PayrollWorker")
  payrollPaid  PayrollPayment[] @relation("PayrollPayer")

  @@map("users")
}

model Branch {
  id        Int            @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  active    Boolean        @default(true)
  registers Register[]
  users     User[]
  sales     Sale[]
  orders    ServiceOrder[]

  @@map("branches")
}

model Register {
  id       Int            @id @default(autoincrement())
  branchId Int
  name     String
  active   Boolean        @default(true)
  branch   Branch         @relation(fields: [branchId], references: [id])
  sessions CashSession[]
  sales    Sale[]
  orders   ServiceOrder[]

  @@map("registers")
}

model Company {
  id               Int     @id @default(autoincrement())
  name             String
  tradeName        String?
  ruc              String?
  address          String?
  phone            String?
  email            String?
  city             String?
  voucherTitle     String  @default("BOUCHER")
  headerLine       String?
  voucherFooter    String?
  warrantyNote     String?
  taxRate          Decimal @default(15) @db.Decimal(5, 2)
  pricesIncludeTax Boolean @default(true)
  currency         String  @default("C$")
  ticketWidth      Int     @default(80)

  @@map("company")
}

model Customer {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String?
  ruc       String?
  plate     String?
  vehicle   String?
  notes     String?
  createdAt DateTime       @default(now())
  sales     Sale[]
  orders    ServiceOrder[]

  @@index([name])
  @@index([plate])
  @@map("customers")
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String
  contact  String?
  phone    String?
  ruc      String?
  address  String?
  email    String?
  products Product[]
  receipts GoodsReceipt[]

  @@map("suppliers")
}

model Product {
  id         Int       @id @default(autoincrement())
  sku        String    @unique
  barcode    String?   @unique
  name       String
  category   String?
  unit       String    @default("UND")
  cost       Decimal   @db.Decimal(12, 2)
  price      Decimal   @db.Decimal(12, 2)
  stock      Decimal   @default(0) @db.Decimal(12, 2)
  minStock   Decimal   @default(0) @db.Decimal(12, 2)
  supplierId Int?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  receiptLines GoodsReceiptLine[]

  @@index([name])
  @@map("products")
}

model ServiceItem {
  id            Int                @id @default(autoincrement())
  code          String             @unique
  name          String
  description   String?
  price         Decimal            @db.Decimal(12, 2)
  cost          Decimal            @default(0) @db.Decimal(12, 2)
  workerAmount  Decimal            @default(0) @db.Decimal(12, 2)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  orderLines    ServiceOrderLine[]

  @@index([name])
  @@map("services")
}

model CashSession {
  id             Int            @id @default(autoincrement())
  registerId     Int
  userId         Int
  status         CashStatus     @default(OPEN)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  openingAmount  Decimal        @db.Decimal(12, 2)
  countedAmount  Decimal?       @db.Decimal(12, 2)
  expectedAmount Decimal?       @db.Decimal(12, 2)
  difference     Decimal?       @db.Decimal(12, 2)
  notes          String?
  register       Register       @relation(fields: [registerId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  sales          Sale[]
  orders         ServiceOrder[]
  payroll        PayrollPayment[]

  @@index([status])
  @@map("cash_sessions")
}

model Sale {
  id             Int           @id @default(autoincrement())
  number         Int           @unique
  clientUuid     String?       @unique
  kind           SaleKind      @default(SALE)
  status         DocStatus     @default(PAID)
  businessDate   DateTime      @db.Date
  customerId     Int?
  customerName   String        @default("Consumidor final")
  plate          String?
  vehicle        String?
  paymentMethod  PaymentMethod
  cashAmount     Decimal       @default(0) @db.Decimal(12, 2)
  cardAmount     Decimal       @default(0) @db.Decimal(12, 2)
  transferAmount Decimal       @default(0) @db.Decimal(12, 2)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  profit         Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  branchId       Int?
  registerId     Int?
  cashSessionId  Int?
  cashierId      Int?
  cashierName    String
  relatedSaleId  Int?
  createdAt      DateTime      @default(now())
  customer       Customer?     @relation(fields: [customerId], references: [id])
  branch         Branch?       @relation(fields: [branchId], references: [id])
  register       Register?     @relation(fields: [registerId], references: [id])
  cashSession    CashSession?  @relation(fields: [cashSessionId], references: [id])
  cashier        User?         @relation(fields: [cashierId], references: [id])
  items          SaleItem[]

  @@index([businessDate])
  @@index([kind])
  @@map("sales")
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  productId   Int?
  sku         String
  name        String
  quantity    Decimal @db.Decimal(12, 2)
  returnedQty Decimal @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  profit      Decimal @default(0) @db.Decimal(12, 2)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_items")
}

model ServiceOrder {
  id             Int                @id @default(autoincrement())
  number         Int                @unique
  clientUuid     String?            @unique
  status         OrderStatus        @default(OPEN)
  businessDate   DateTime           @db.Date
  customerId     Int?
  customerName   String
  phone          String?
  plate          String?
  vehicle        String?
  brought        BroughtItem        @default(NONE)
  broughtNote    String?
  paymentMethod  PaymentMethod?
  cashAmount     Decimal            @default(0) @db.Decimal(12, 2)
  cardAmount     Decimal            @default(0) @db.Decimal(12, 2)
  transferAmount Decimal            @default(0) @db.Decimal(12, 2)
  subtotal       Decimal            @db.Decimal(12, 2)
  discount       Decimal            @default(0) @db.Decimal(12, 2)
  tax            Decimal            @default(0) @db.Decimal(12, 2)
  total          Decimal            @db.Decimal(12, 2)
  profit         Decimal            @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal            @default(0) @db.Decimal(12, 2)
  notes          String?
  branchId       Int?
  registerId     Int?
  cashSessionId  Int?
  cashierId      Int?
  cashierName    String
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  customer       Customer?          @relation(fields: [customerId], references: [id])
  branch         Branch?            @relation(fields: [branchId], references: [id])
  register       Register?          @relation(fields: [registerId], references: [id])
  cashSession    CashSession?       @relation(fields: [cashSessionId], references: [id])
  cashier        User?              @relation(fields: [cashierId], references: [id])
  lines          ServiceOrderLine[]

  @@index([businessDate])
  @@index([status])
  @@map("service_orders")
}

model ServiceOrderLine {
  id        Int          @id @default(autoincrement())
  orderId   Int
  kind      LineKind
  productId Int?
  serviceId Int?
  code      String
  name      String
  quantity  Decimal      @db.Decimal(12, 2)
  unitPrice Decimal      @db.Decimal(12, 2)
  unitCost  Decimal      @db.Decimal(12, 2)
  discount  Decimal      @default(0) @db.Decimal(12, 2)
  amount           Decimal         @db.Decimal(12, 2)
  profit           Decimal         @default(0) @db.Decimal(12, 2)
  payrollPaymentId Int?
  order            ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service          ServiceItem?    @relation(fields: [serviceId], references: [id])
  payrollPayment   PayrollPayment? @relation(fields: [payrollPaymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([payrollPaymentId])
  @@map("service_order_lines")
}

model GoodsReceipt {
  id            Int                @id @default(autoincrement())
  invoiceNumber String
  supplierId    Int?
  supplierName  String?
  notes         String?
  userId        Int
  createdAt     DateTime           @default(now())
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  lines         GoodsReceiptLine[]

  @@index([createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id        Int          @id @default(autoincrement())
  receiptId Int
  productId Int
  quantity  Decimal      @db.Decimal(12, 2)
  cost      Decimal      @db.Decimal(12, 2)
  price     Decimal      @db.Decimal(12, 2)
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_lines")
}

model PayrollPayment {
  id            Int           @id @default(autoincrement())
  userId        Int
  paidById      Int
  paidAt        DateTime      @db.Date
  periodFrom    DateTime      @db.Date
  periodTo      DateTime      @db.Date
  kind          PayKind       @default(SALARY)
  method        PaymentMethod @default(CASH)
  amount        Decimal       @db.Decimal(12, 2)
  notes         String?
  cashSessionId Int?
  createdAt     DateTime      @default(now())
  user          User               @relation("PayrollWorker", fields: [userId], references: [id])
  paidBy        User               @relation("PayrollPayer", fields: [paidById], references: [id])
  cashSession   CashSession?       @relation(fields: [cashSessionId], references: [id])
  serviceLines  ServiceOrderLine[]

  @@index([paidAt])
  @@index([userId])
  @@map("payroll_payments")
}

model StockMove {
  id        Int      @id @default(autoincrement())
  productId Int
  qty       Decimal  @db.Decimal(12, 2)
  reason    String
  ref       String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("stock_moves")
}
